      <TR><TD PORT="special" COLSPAN="3" BGCOLOR="#f4f7da" ALIGN="LEFT">special</TD></TR>
      <TR><TD PORT="common_prod_id" COLSPAN="3" ALIGN="LEFT">common_prod_id</TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#f7f7f7">  </TD><TD ALIGN="RIGHT" BGCOLOR="#f7f7f7">10,000 rows</TD><TD ALIGN="RIGHT" BGCOLOR="#f7f7f7">  </TD></TR>
    </TABLE>>
